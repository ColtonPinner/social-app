PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_app
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me-with-a-long-random-secret
CF_IMAGES_ACCOUNT_ID=your-cloudflare-account-id
CF_IMAGES_API_TOKEN=your-cloudflare-images-api-token

# Back4App (Parse) provider
BACK4APP_SERVER_URL=https://parseapi.back4app.com
BACK4APP_APP_ID=your-back4app-app-id
BACK4APP_REST_API_KEY=your-back4app-rest-api-key
# Optional for privileged operations
BACK4APP_MASTER_KEY=
BACK4APP_JAVASCRIPT_KEY=
BACK4APP_TIMEOUT_MS=15000

# Data migration (Supabase -> Cloudflare Postgres)
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
CLOUDFLARE_DATABASE_URL=postgresql://user:password@your-cloudflare-postgres-host:5432/social_app
MIGRATION_TEMP_PASSWORD=ChangeMe123!
